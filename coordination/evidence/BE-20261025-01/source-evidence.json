        "3": "const STORAGE_KEY = 'yijiexing.coupons.v1';",
        "4": "",
        "5": "/**",
        "6": " * 原团队优惠券模板定义（参考《宜捷行优惠券开发V-20260914.xlsx》）：",
        "7": " * 1. 满减券门槛与减免金额精确到分",
        "8": " * 2. 适用城市精确到区县（当阳市、宜昌市或全部）",
        "9": " * 3. 适用订单类型（全部、普通叫车 STANDARD、预约用车 RESERVED 等），明确排斥司机竞价(BID)",
        "10": " * 4. 有效期支持固定时间起止与天数",
        "101": "function isCouponApplicable(coupon, context) {",
        "102": "  if (!coupon || coupon.status !== 'AVAILABLE') return false;",
        "103": "",
        "104": "  const baseFare = typeof context === 'number' ? context : (context.baseFareCents || 0);",
        "105": "  const orderType = (context && context.orderType) || 'STANDARD';",
        "106": "  const city = (context && context.city) || '宜昌市';",
        "107": "  const pricingMode = (context && context.pricingMode) || 'ONLINE';",
        "108": "",
        "109": "  // 竞价订单排除",
        "110": "  if (pricingMode === 'BID' || orderType === 'BID') return false;",
        "111": "",
        "112": "  // 门槛判断（只看运费本金，不包含小费）",
        "113": "  if (baseFare < (coupon.minSpendCents || 0)) return false;",
        "114": "",
        "115": "  // 城市校验",
        "116": "  if (Array.isArray(coupon.applicableCities) && !coupon.applicableCities.includes('ALL')) {",
        "117": "    if (!coupon.applicableCities.some(c => city.includes(c) || c.includes(city))) {",
        "118": "      return false;",
        "119": "    }",
        "120": "  }",
        "121": "",
        "122": "  // 订单类型校验",
        "123": "  if (Array.isArray(coupon.applicableOrderTypes) && !coupon.applicableOrderTypes.includes('ALL')) {",
        "124": "    if (!coupon.applicableOrderTypes.includes(orderType)) {",
        "125": "      return false;",
        "126": "    }",
        "127": "  }",
        "128": "",
        "129": "  return true;",
        "183": " * 下单时冻结优惠券（遵循特殊规则第5条：下单后进入冻结状态，不作真实核销）",
        "184": " */",
        "185": "function freezeCoupon(couponId, orderId, wxPlatform) {",
        "186": "  const list = loadCoupons(wxPlatform);",
        "187": "  const target = list.find(c => c.id === couponId);",
        "188": "  if (target && target.status === 'AVAILABLE') {",
        "189": "    target.status = 'FROZEN';",
        "190": "    target.frozenOrderId = orderId;",
        "191": "    target.frozenAt = new Date().toISOString();",
        "192": "    saveCoupons(list, wxPlatform);",
        "193": "    return true;",
        "194": "  }",
        "195": "  return false;",
        "196": "}",
        "197": "",
        "198": "/**",
        "199": " * 退券逻辑（遵循特殊规则第4条：乘客取消、有责取消、后台有责/无责取消、超时取消均退券）",
        "200": " */",
        "201": "function releaseCoupon(couponId, reason, wxPlatform) {",
        "202": "  const list = loadCoupons(wxPlatform);",
        "203": "  const target = list.find(c => c.id === couponId);",
        "204": "  if (target && (target.status === 'FROZEN' || target.status === 'USED')) {",
        "205": "    target.status = 'AVAILABLE';",
        "206": "    target.releasedReason = reason || 'ORDER_CANCELLED';",
        "207": "    target.releasedAt = new Date().toISOString();",
        "208": "    delete target.frozenOrderId;",
        "209": "    delete target.usedOrderId;",
        "210": "    saveCoupons(list, wxPlatform);",
        "211": "    return true;",
        "212": "  }",
        "213": "  return false;",
        "214": "}",
        "215": "",
        "216": "/**",
        "217": " * 订单完成并入账时真实核销优惠券",
        "218": " */",
        "219": "function consumeCoupon(couponId, orderId, wxPlatform) {",
        "220": "  const list = loadCoupons(wxPlatform);",
        "221": "  const target = list.find(c => c.id === couponId);",
        "222": "  if (target) {",
        "223": "    target.status = 'CONSUMED';",
        "224": "    target.consumedAt = new Date().toISOString();",
        "225": "    target.consumedOrderId = orderId;",
        "240": "function claimCoupon(couponCode, wxPlatform) {",
        "241": "  const list = loadCoupons(wxPlatform);",
        "242": "  const code = (couponCode || '').toUpperCase().trim();",
        "243": "  if (!code) return { success: false, message: '请输入兑换码' };",
        "244": "",
        "245": "  if (list.some(c => c.id === code && c.status === 'AVAILABLE')) {",
        "246": "    return { success: false, message: '您已拥有该优惠券，不可重复领取' };",
        "247": "  }",
        "248": "",
        "249": "  // 模拟兑换特定体验券",
        "250": "  const newCoupon = {",
        "251": "    id: 'CLAIM_' + code + '_' + Date.now().toString().slice(-4),",
        "252": "    title: '专属体验兑换券',",
        "253": "    type: 'AMOUNT',",
        "254": "    discountCents: 1500,",
        "255": "    minSpendCents: 3000,",
        "256": "    expiresAt: '2026-12-31',",
        "257": "    description: `兑换码[${code}]专享立减15元`,",
        "258": "    status: 'AVAILABLE',",
        "259": "    applicableCities: ['ALL'],",
        "260": "    applicableOrderTypes: ['ALL', 'STANDARD', 'RESERVED']",
        "261": "  };",
        "262": "",
        "263": "  list.unshift(newCoupon);",
        "264": "  saveCoupons(list, wxPlatform);",
        "265": "  return { success: true, message: '领取成功！已存入卡券中心', coupon: newCoupon };"
      }
    },
