        "60": "function loadPointsData(wxPlatform) {",
        "61": "  const p = getStorage(wxPlatform);",
        "62": "  if (!p) return JSON.parse(JSON.stringify(DEFAULT_POINTS_DATA));",
        "63": "  try {",
        "64": "    const data = p.getStorageSync(STORAGE_KEY_POINTS);",
        "65": "    if (data && typeof data === 'object' && typeof data.totalPoints === 'number') {",
        "66": "      return data;",
        "67": "    }",
        "68": "  } catch (_) {}",
        "69": "  const initial = JSON.parse(JSON.stringify(DEFAULT_POINTS_DATA));",
        "70": "  try {",
        "71": "    p.setStorageSync(STORAGE_KEY_POINTS, initial);",
        "72": "  } catch (_) {}",
        "73": "  return initial;",
        "74": "}",
        "75": "",
        "76": "function savePointsData(data, wxPlatform) {",
        "77": "  const p = getStorage(wxPlatform);",
        "78": "  if (!p) return;",
        "79": "  try {",
        "80": "    p.setStorageSync(STORAGE_KEY_POINTS, data);",
        "81": "  } catch (_) {}",
        "82": "}",
        "83": "",
        "84": "function awardPoints(type, points, description, wxPlatform) {",
