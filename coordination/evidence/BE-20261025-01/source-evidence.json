      "lines": {
        "3": "const STORAGE_KEY_POINTS = 'yijiexing.points.v1';",
        "4": "",
        "5": "const DEFAULT_POINTS_DATA = {",
        "6": "  totalPoints: 380,",
        "7": "  availablePoints: 380,",
        "8": "  referralStats: {",
        "9": "    invitedCount: 3,",
