.home-container {
  min-height: 100vh;
  background-color: #f2f6f7;
  padding-bottom: 60rpx;
  box-sizing: border-box;
}

.top-nav-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx 16rpx;
  background: #ffffff;
}

.brand-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #00796e;
  letter-spacing: 2rpx;
}

.brand-city {
  font-size: 22rpx;
  color: #4b5b6b;
  margin-top: 4rpx;
}

.scan-pill {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #e0f2fe;
  color: #0369a1;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 600;
}

/* 进行中订单胶囊条 */
.active-order-banner {
  background: linear-gradient(135deg, #00796e 0%, #0f9488 100%);
  color: #ffffff;
  padding: 20rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(8, 127, 115, 0.2);
}

.pulse-dot {
  width: 18rpx;
  height: 18rpx;
  background: #ffea79;
  border-radius: 50%;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0% { transform: scale(0.9); opacity: 0.8; }
  50% { transform: scale(1.3); opacity: 1; }
  100% { transform: scale(0.9); opacity: 0.8; }
}

.active-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
}

.active-sub {
  display: block;
  font-size: 20rpx;
  opacity: 0.9;
  margin-top: 2rpx;
}

/* 地图区 */
.map-wrap {
  width: 100%;
  background: #ffffff;
  position: relative;
}

.main-map {
  width: 100%;
  height: 380rpx;
}

.map-hint {
  font-size: 20rpx;
  color: #5b6b7a;
  text-align: center;
  padding: 8rpx 0;
  background: #f0f5f4;
}

/* 下单核心卡片 */
.booking-card {
  margin: -30rpx 24rpx 0;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 28rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 10;
  border: 1rpx solid #dce5e8;
}

/* 类型 Tabs */
.kind-tabs {
  display: flex;
  background: #f2f6f7;
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #4b5b6b;
  transition: all 0.2s ease;
}

.tab-item.active {
  background: #ffffff;
  color: #00796e;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(8, 127, 115, 0.12);
}

.tab-icon {
  font-size: 28rpx;
}

/* 路线输入区 */
.route-panel {
  border-bottom: 1rpx solid #e6edef;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
}

.point-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.waypoint-row {
  padding-left: 12rpx;
  background: #fbfdfc;
  border-radius: 10rpx;
}

.point-badge {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  margin-right: 18rpx;
}

.start-badge {
  background: #00796e;
}

.via-badge {
  background: #0369a1;
}

.end-badge {
  background: #b45309;
}

.point-content {
  flex: 1;
}

.point-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: 0.5rpx;
  line-height: 1.35;
}

.point-name.placeholder {
  color: #9ca3af;
  font-weight: 500;
  font-size: 34rpx;
}

.quick-pick-btn {
  font-size: 22rpx;
  color: #00796e;
  background: #e3f4f1;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.remove-btn {
  font-size: 22rpx;
  color: #b42318;
  padding: 6rpx 16rpx;
}

.sub-option-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
}

.sub-label {
  font-size: 24rpx;
  color: #4b5b6b;
}

.add-waypoint-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 12rpx 0;
  color: #00796e;
  font-size: 24rpx;
  font-weight: 500;
}

/* 扩展设置卡片 */
.extra-field-card {
  background: #fbfdfc;
  border: 1rpx solid #eef4f3;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 18rpx;
}

.field-header-flex {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 14rpx;
}

.field-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #0f1b2a;
}

.field-sub-val {
  font-size: 24rpx;
  font-weight: 600;
  color: #00796e;
}

.priority-options {
  display: flex;
  gap: 14rpx;
}

.priority-chip {
  flex: 1;
  text-align: center;
  background: #ffffff;
  border: 1rpx solid #d6e2e0;
  padding: 12rpx 0;
  border-radius: 12rpx;
  font-size: 24rpx;
  color: #4b5b6b;
}

.priority-chip.selected {
  background: #e3f4f1;
  border-color: #00796e;
  color: #00796e;
  font-weight: 700;
}

/* 优惠券条 */
.coupon-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.field-left-flex {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.discount-pill {
  font-size: 24rpx;
  color: #b42318;
  background: #fdecea;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-weight: 600;
}

.coupon-placeholder {
  font-size: 24rpx;
  color: #5b6b7a;
}

/* 乘车人与留言 */
.rider-select-row {
  display: flex;
  justify-content: space-between;
  padding: 6rpx 0 14rpx;
  border-bottom: 1rpx solid #e6edef;
}

.rider-title {
  font-size: 26rpx;
  color: #4b5b6b;
}

.rider-name {
  font-size: 26rpx;
  color: #00796e;
  font-weight: 600;
}

.remark-row {
  padding-top: 12rpx;
}

.remark-input {
  font-size: 26rpx;
  color: #0f1b2a;
}

.call-car-btn {
  background: linear-gradient(135deg, #00796e 0%, #0f9488 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 44rpx;
  padding: 12rpx 0;
  box-shadow: 0 8rpx 20rpx rgba(8, 127, 115, 0.3);
  margin-top: 24rpx;
}

.call-car-btn[disabled] {
  background: #cfdedb !important;
  color: #ffffff !important;
  box-shadow: none;
}

.disclaimer-tip {
  font-size: 20rpx;
  color: #5b6b7a;
  text-align: center;
  margin-top: 16rpx;
}

.date-time-flex {
  display: flex;
  gap: 16rpx;
  margin: 12rpx 0;
}

.time-picker {
  flex: 1;
}

.picker-inner {
  background: #ffffff;
  border: 1rpx solid #d6e2e0;
  padding: 14rpx;
  border-radius: 10rpx;
  font-size: 26rpx;
  text-align: center;
}

.field-tip {
  font-size: 20rpx;
  color: #5b6b7a;
}
