<view class="notice">独立体验环境 · 短信、支付与退款均为模拟</view>
<view wx:if="{{error}}" class="error">{{error}}</view>
<view wx:for="{{pending}}" wx:key="requestId" class="notice">
  {{item.actionText}} · {{item.statusText}}
  <button size="mini" data-id="{{item.requestId}}" bindtap="retry">原请求重试</button>
</view>

<view class="home-container">
  <!-- 顶部状态栏 -->
  <view class="top-nav-bar">
    <view class="brand-box">
      <view class="brand-title">宜捷行</view>
      <view class="brand-city">{{state.passenger.cityName || '宜昌市'}} · 出行有道</view>
    </view>
    <view class="scan-pill" data-url="/pages/negotiation/index" bindtap="go">
      <text class="scan-icon">📷</text>
      <text class="scan-text">扫码议价</text>
    </view>
  </view>

  <!-- 进行中订单高亮浮条（原型顶部醒目提示） -->
  <view wx:if="{{active}}" class="active-order-banner" bindtap="go" data-url="/pages/order-detail/index?id={{active.id}}">
    <view class="pulse-dot"></view>
    <view class="active-info">
      <text class="active-title">您有一笔进行中的行程</text>
      <text class="active-sub">点击实时查看司机位置与行程进度 ›</text>
    </view>
  </view>

  <!-- 地图展示区 -->
  <view wx:for="{{reservations}}" wx:key="id" class="active-order-banner" bindtap="go" data-url="/pages/order-detail/index?id={{item.id}}">
    <view class="active-info">
      <text class="active-title">待出发预约 · {{item.scheduledAtText}}</text>
      <text class="active-sub">预约保留，可继续即时叫车 · 查看详情 ›</text>
    </view>
  </view>
  <view class="map-wrap">
    <map class="main-map" latitude="{{mapLat}}" longitude="{{mapLng}}" markers="{{markers}}" scale="13" show-location="{{false}}" />
    <view class="map-hint">📍 地图示意所选地点路线，实际以司机接驾导航为准</view>
  </view>

  <!-- 下单核心卡片 -->
  <view class="booking-card">
    <!-- 用车类型 Tabs -->
    <view class="kind-tabs">
      <view class="tab-item {{kind==='STANDARD'?'active':''}}" data-kind="STANDARD" bindtap="chooseKind">
        <text class="tab-icon">🚗</text>
        <text class="tab-name">现在叫车</text>
      </view>
      <view class="tab-item {{kind==='RESERVED'?'active':''}}" data-kind="RESERVED" bindtap="chooseKind">
        <text class="tab-icon">⏰</text>
        <text class="tab-name">预约用车</text>
      </view>
      <view class="tab-item {{kind==='BID'?'active':''}}" data-kind="BID" bindtap="chooseKind">
        <text class="tab-icon">⚡</text>
        <text class="tab-name">司机竞价</text>
      </view>
    </view>

    <!-- 路线起终点 -->
    <view class="route-panel">
      <!-- 起点 -->
      <view class="point-row">
        <view class="point-badge start-badge"></view>
        <view class="point-content">
          <view class="point-name {{origin ? '' : 'placeholder'}}" data-purpose="origin" bindtap="choosePoint">
            {{origin ? origin.name : '从哪里出发？'}}
          </view>
        </view>
        <view class="quick-pick-btn" data-purpose="origin" bindtap="experience">常用点</view>
      </view>

      <!-- 途经点列表 -->
      <view wx:for="{{waypoints}}" wx:key="index" class="point-row waypoint-row">
        <view class="point-badge via-badge"></view>
        <view class="point-content">
          <view class="point-name">{{item.name}}</view>
        </view>
        <view class="remove-btn" data-index="{{index}}" bindtap="removeWaypoint">移除</view>
      </view>

      <!-- 终点 -->
      <view class="point-row">
        <view class="point-badge end-badge"></view>
        <view class="point-content">
          <view class="point-name {{destination ? '' : 'placeholder'}}" data-purpose="destination" bindtap="choosePoint">
            {{destination ? destination.name : '您要去哪里？'}}
          </view>
        </view>
        <view class="quick-pick-btn" data-purpose="destination" bindtap="experience">常用点</view>
      </view>

      <view wx:if="{{waypoints.length < 2}}" class="add-waypoint-row" data-purpose="waypoint" bindtap="experience">
        <text class="add-icon">+</text>
        <text class="add-text">添加途经点（最多2个）</text>
      </view>
    </view>

    <!-- 预约时间选择 -->
    <view wx:if="{{kind==='RESERVED'}}" class="extra-field-card">
      <view class="field-title">预约出发时间</view>
      <view class="date-time-flex">
        <picker mode="date" bindchange="date" class="time-picker">
          <view class="picker-inner">📅 {{scheduledDate || '选择预约日期'}}</view>
        </picker>
        <picker mode="time" bindchange="time" class="time-picker">
          <view class="picker-inner">🕒 {{scheduledTime || '选择具体时间'}}</view>
        </picker>
      </view>
      <view class="field-tip">预约时间需在未来15分钟至30天内。</view>
    </view>

    <!-- 调度加价选项（体验中未接入派单引擎） -->
    <view class="extra-field-card">
      <view class="field-header-flex">
        <text class="field-title">调度加价（体验中·未接入实际调度费）</text>
        <text class="field-sub-val">{{priorityFee > 0 ? '+¥' + (priorityFee / 100) : '未加价'}}</text>
      </view>
      <view class="priority-options">
        <view wx:for="{{priorityOptions}}" wx:key="value" 
              class="priority-chip {{priorityFee === item.value ? 'selected' : ''}}" 
              bindtap="onSelectPriority" data-value="{{item.value}}">
          <text class="chip-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 优惠券包查看（待营销服务端接入统一账务） -->
    <view class="extra-field-card coupon-bar" bindtap="goCoupons">
      <view class="field-left-flex">
        <text class="coupon-icon">🎟️</text>
        <text class="field-title">我的卡券包（待营销服务接入）</text>
      </view>
      <view class="field-right-flex">
        <text class="coupon-placeholder">查看券包明细 ›</text>
      </view>
    </view>

    <!-- 乘车人与留言 -->
    <view class="extra-field-card">
      <picker range="{{riderOptions}}" range-key="name" bindchange="chooseRider">
        <view class="rider-select-row">
          <text class="rider-title">乘车人：</text>
          <text class="rider-name">{{riderLabel}}（点击切换代叫人）›</text>
        </view>
      </picker>
      <view class="remark-row">
        <input class="remark-input" maxlength="200" placeholder="给司机留言，例如有大件行李、特定上车点" value="{{remark}}" data-field="remark" bindinput="input" />
      </view>
    </view>

    <!-- 底部确认呼叫按钮 -->
    <button class="call-car-btn" bindtap="submit" disabled="{{busy || !!active}}">
      {{authenticated ? (kind==='BID' ? '发起竞价呼叫' : '立即呼叫用车') : '登录后呼叫用车'}}
    </button>
    <view class="disclaimer-tip">金额由宜捷行体验服务估算；竞价须选择司机报价。请勿用于真实交通运营。</view>
  </view>
</view>
