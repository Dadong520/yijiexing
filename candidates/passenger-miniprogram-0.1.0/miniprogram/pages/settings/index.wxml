<view class="notice">独立体验环境 · 短信、支付与退款均为模拟</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{pending}}" wx:key="requestId" class="notice">{{item.actionText}} · {{item.statusText}}<button size="mini" data-id="{{item.requestId}}" bindtap="retry">原请求重试</button></view><view class="page"><button wx:if="{{!authenticated}}" bindtap="login">请先登录</button><block wx:if="{{section==='profile'}}"><view class="title">个人资料</view><view class="card"><input placeholder="姓名（2—30字）" data-field="name" value="{{name}}" bindinput="input"/><view class="muted">当前：{{state.passenger.name}} · {{state.passenger.cityName}}</view><picker range="{{state.regions}}" range-key="name" bindchange="city"><view class="point">{{regionName || '选择服务城市'}}</view></picker><view class="muted">进行中的行程结束后才能切换城市。</view><button class="primary" bindtap="saveProfile" disabled="{{busy}}">保存资料</button></view></block><block wx:if="{{section==='riders'}}"><view class="title">乘车人管理</view><view class="card" wx:for="{{state.riders}}" wx:key="id"><view class="subtitle">{{item.name}} · {{item.mobile}}</view><view class="row"><button size="mini" data-id="{{item.id}}" bindtap="editRider">编辑</button><button size="mini" data-id="{{item.id}}" bindtap="removeRider">删除</button></view></view><view class="card"><view class="subtitle">{{editId?'编辑乘车人':'添加乘车人'}}</view><input placeholder="乘车人姓名" value="{{name}}" data-field="name" bindinput="input"/><input type="number" maxlength="11" placeholder="乘车人手机号" value="{{mobile}}" data-field="mobile" bindinput="input"/><button class="primary" bindtap="saveRider" disabled="{{busy}}">保存乘车人</button><view class="muted">代叫行程使用实际乘车人的手机号尾号核验。</view></view></block><block wx:if="{{section==='invoices'}}"><view class="title">发票与模拟回执</view><view class="notice">仅提供体验回执，不是税务发票，不能报销。未连接开票平台，不发送邮件。</view><view class="card" wx:for="{{state.invoiceTitles}}" wx:key="id"><view class="subtitle">{{item.title}}</view><view>{{item.type==='COMPANY'?'企业':'个人'}} {{item.taxNumber}}</view><view>{{item.email}}</view><view class="row"><button size="mini" data-id="{{item.id}}" bindtap="editTitle">编辑</button><button size="mini" data-id="{{item.id}}" bindtap="removeTitle">删除</button></view></view><view class="card"><view class="subtitle">{{editId?'修改抬头':'添加抬头'}}</view><view class="row"><button size="mini" data-type="PERSONAL" bindtap="invoiceType">个人{{invoiceType==='PERSONAL'?' ✓':''}}</button><button size="mini" data-type="COMPANY" bindtap="invoiceType">企业{{invoiceType==='COMPANY'?' ✓':''}}</button></view><input placeholder="抬头名称" value="{{title}}" data-field="title" bindinput="input"/><input wx:if="{{invoiceType==='COMPANY'}}" placeholder="企业税号" value="{{taxNumber}}" data-field="taxNumber" bindinput="input"/><input placeholder="邮箱（可选，不实际发送）" value="{{email}}" data-field="email" bindinput="input"/><button bindtap="saveTitle" disabled="{{busy}}">保存抬头</button></view><view wx:if="{{state.passengerFeatureSwitches.invoice===false}}" class="notice">本地区已关闭新的模拟开票申请，历史回执仍可查看。</view><view wx:if="{{state.passengerFeatureSwitches.invoice!==false}}" class="card"><view class="subtitle">申请模拟回执</view><picker range="{{state.invoiceTitles}}" range-key="title" bindchange="titlePick"><view class="point">{{titleLabel}}</view></picker><view class="empty" wx:if="{{!eligibleOrders.length}}">暂无已完成并已支付的行程。</view><view wx:for="{{eligibleOrders}}" wx:key="id" class="point"><view>{{item.origin}} → {{item.destination}}</view><button size="mini" data-id="{{item.id}}" bindtap="apply" disabled="{{busy}}">申请模拟回执</button></view></view><view wx:for="{{state.invoices}}" wx:key="id" class="card"><view>{{item.title}} · {{item.statusText}}</view><view class="muted">{{item.notice}} {{item.createdAtText}}</view></view></block><block wx:if="{{section==='blocked'}}"><view class="title">屏蔽司机</view><view class="empty" wx:if="{{!state.blockedDrivers.length}}">暂无屏蔽司机，可在已结束的行程中操作。</view><view class="card" wx:for="{{state.blockedDrivers}}" wx:key="driverId"><view>{{item.name}} · {{item.plate}}</view><view class="muted">{{item.reason}}</view><button data-id="{{item.driverId}}" bindtap="unblock">解除屏蔽</button></view></block><block wx:if="{{section==='feedback'}}"><view class="title">意见反馈</view><view class="card"><textarea maxlength="2000" placeholder="请描述建议或问题（5—2000字）" value="{{content}}" data-field="content" bindinput="input"/><button class="primary" bindtap="feedback" disabled="{{busy}}">提交反馈</button></view><view wx:for="{{state.feedback}}" wx:key="id" class="card"><view>{{item.content}}</view><view class="muted">{{item.statusText}} {{item.createdAtText}}</view><view>{{item.reply}}</view></view></block><block wx:if="{{section==='support'}}"><view class="title">公告与客服</view><view class="card"><view class="subtitle">公司客服电话</view><view>{{state.company.name}}</view><view>{{state.company.supportPhone || state.company.statusText}}</view><view class="muted">优先使用当前订单公司，其次本人选择；不改变历史订单或派单归属。</view><button wx:if="{{state.company.supportPhone}}" bindtap="callCompany">联系公司客服</button><view wx:for="{{state.operations.companies}}" wx:key="id"><button data-id="{{item.id}}" bindtap="selectCompany" disabled="{{busy}}">选择 {{item.name}}</button></view><button bindtap="selectCompany" disabled="{{busy}}">清除本人选择</button></view><view wx:for="{{state.notices}}" wx:key="index" class="card"><view class="subtitle">{{item.title}}</view><view>{{item.content}}</view></view><view wx:for="{{state.support.notices}}" wx:key="id" class="card"><view class="subtitle">{{item.title}}</view><view>{{item.content}}</view></view><view class="card"><view class="subtitle">服务能力说明</view><view>{{state.support.notice}}</view><view wx:for="{{state.support.capabilities}}" wx:key="key" class="point"><view>{{item.label}} · {{item.statusText}}</view><view class="muted">{{item.notice}}</view></view><view class="notice">实时聊天、电话中继与外部推送未配置；公司电话由后台维护。行程问题请在订单中提交投诉，其他建议可提交反馈。</view></view></block></view>