page{background:#f3f5f8;color:#152b3b;font-size:30rpx;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}view,text,button,input,textarea{box-sizing:border-box}.page{padding:30rpx 28rpx 60rpx}.title{font-size:48rpx;line-height:1.4;font-weight:700;margin:8rpx 0 18rpx}.subtitle{font-size:34rpx;font-weight:600;line-height:1.5}.card{background:#fff;border-radius:24rpx;padding:28rpx;margin:24rpx 0;box-shadow:0 6rpx 24rpx rgba(19,45,60,.035)}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:12rpx 0;flex-wrap:wrap}.muted{font-size:25rpx;color:#647786;line-height:1.7;margin:10rpx 0;word-break:break-all}.notice{background:#eaf3ff;color:#305573;font-size:25rpx;line-height:1.6;padding:18rpx 24rpx}.error{background:#fff0ee;color:#9f342f;padding:20rpx;word-break:break-all}.empty{padding:32rpx 12rpx;color:#73838e;line-height:1.7}.primary{background:#086e62!important;color:#fff!important;font-weight:600}.danger{color:#b14b3b;background:#fff4f0}button{font-size:30rpx;border-radius:16rpx;margin:16rpx 0;min-height:88rpx;line-height:88rpx}button[size=mini]{font-size:25rpx;min-height:64rpx;line-height:64rpx;margin:6rpx 0;padding:0 22rpx}button::after{border:0}button[disabled]{opacity:.5}input,textarea{background:#f5f7f9;width:100%;border-radius:14rpx;padding:24rpx;margin:18rpx 0;font-size:30rpx}input{height:94rpx}textarea{min-height:160rpx;height:180rpx}.menu>view{padding:30rpx 0;border-bottom:1rpx solid #edf0f2;line-height:1.5}.tabs{display:flex;gap:10rpx;margin-bottom:16rpx}.tabs>view{flex:1;text-align:center;padding:24rpx 4rpx;color:#637581;border-radius:16rpx;background:#f4f6f8}.tabs>.selected{color:#fff;background:#086e62;font-weight:600}.point{padding:24rpx 0;border-bottom:1rpx solid #edf0f2;line-height:1.7}.route{font-size:32rpx;margin:18rpx 0;line-height:1.6}.badge{color:#086e62;font-size:25rpx;background:#e7f5ee;border-radius:10rpx;padding:8rpx 14rpx}.map{width:100%;height:380rpx;border-radius:24rpx;overflow:hidden;margin-top:20rpx}picker{padding:14rpx 0;line-height:1.8}