page{background:#f2f6f7;color:#0f1b2a;font-size:30rpx;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif}view,text,button,input,textarea{box-sizing:border-box}.page{padding:30rpx 28rpx 60rpx}.title{font-size:48rpx;line-height:1.4;font-weight:700;margin:8rpx 0 18rpx}.subtitle{font-size:34rpx;font-weight:600;line-height:1.5}.card{background:#fff;border:1rpx solid #dce5e8;border-radius:24rpx;padding:28rpx;margin:24rpx 0;box-shadow:0 6rpx 20rpx rgba(15,27,42,.05)}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:12rpx 0;flex-wrap:wrap}.muted{font-size:25rpx;color:#4b5b6b;line-height:1.7;margin:10rpx 0;word-break:break-all}.notice{background:#e0f2fe;color:#075985;border-left:6rpx solid #0369a1;border-radius:12rpx;font-size:25rpx;line-height:1.6;padding:18rpx 24rpx}.error{background:#fdecea;color:#b42318;border-left:6rpx solid #b42318;border-radius:12rpx;padding:20rpx;word-break:break-all}.empty{padding:32rpx 12rpx;color:#4b5b6b;line-height:1.7}.primary{background:#00796e!important;color:#fff!important;font-weight:600}.danger{color:#b42318;background:#fdecea}.warning{color:#b45309;background:#fff4e5}.success{color:#1b7a3e;background:#e6f4ea}button{font-size:30rpx;border-radius:16rpx;margin:16rpx 0;min-height:88rpx;line-height:88rpx}button[size=mini]{font-size:25rpx;min-height:64rpx;line-height:64rpx;margin:6rpx 0;padding:0 22rpx}button::after{border:0}button{background:#fff;color:#005f56;border:1rpx solid #b7dcd6}button[disabled]{opacity:.5}input,textarea{background:#f7fafb;border:1rpx solid #dce5e8;width:100%;border-radius:14rpx;padding:24rpx;margin:18rpx 0;font-size:30rpx}input{height:94rpx}textarea{min-height:160rpx;height:180rpx}input:focus,textarea:focus{border-color:#00796e;background:#fff}.menu>view{padding:30rpx 0;border-bottom:1rpx solid #e6edef;line-height:1.5}.tabs{display:flex;gap:10rpx;margin-bottom:16rpx}.tabs>view{flex:1;text-align:center;padding:24rpx 4rpx;color:#4b5b6b;border-radius:16rpx;background:#fff;border:1rpx solid #dce5e8}.tabs>.selected{color:#fff;background:#00796e;border-color:#00796e;font-weight:600}.point{padding:24rpx 0;border-bottom:1rpx solid #e6edef;line-height:1.7}.route{font-size:32rpx;margin:18rpx 0;line-height:1.6}.badge{color:#005f56;font-size:25rpx;background:#e3f4f1;border-radius:10rpx;padding:8rpx 14rpx}.map{width:100%;height:380rpx;border-radius:24rpx;overflow:hidden;margin-top:20rpx}picker{padding:14rpx 0;line-height:1.8}