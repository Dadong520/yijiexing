<view class="notice">独立体验环境 · 短信、支付与退款均为模拟</view>
<view wx:if="{{error}}" class="error">{{error}}</view>
<view wx:for="{{pending}}" wx:key="requestId" class="notice">
  {{item.actionText}} · {{item.statusText}}
  <button size="mini" data-id="{{item.requestId}}" bindtap="retry">原请求重试</button>
</view>

<view class="profile-container">
  <!-- 顶部个人卡片 -->
  <view class="user-card">
    <view class="avatar-wrap">
      <view class="avatar-circle">🚗</view>
    </view>
    <view class="user-meta">
      <view class="name-row">
        <text class="user-name">{{state.passenger.name || '宜捷行乘客'}}</text>
        <text class="vip-badge">尊享会员</text>
      </view>
      <text class="user-phone">{{state.passenger.mobile || '登录后体验完整出行服务'}}</text>
    </view>
    <button wx:if="{{!authenticated}}" class="login-pill" bindtap="login">登录体验</button>
  </view>

  <!-- 营销积分与拉新数据看板（前端演示·待服务端接入统一账务） -->
  <view class="points-notice-bar" style="font-size: 20rpx; color: #647774; text-align: center; margin-bottom: 8rpx;">
    营销拉新积分（前端体验预览 · 待服务端统一账务接入）
  </view>
  <view class="points-stats-card">
    <view class="points-col" bindtap="onOpenPoints">
      <view class="points-num">{{pointsData.availablePoints || 0}}</view>
      <view class="points-label">我的积分 (明细›)</view>
    </view>
    <view class="points-divider"></view>
    <view class="points-col" bindtap="onOpenInvite">
      <view class="points-num">{{pointsData.referralStats.invitedCount || 0}}</view>
      <view class="points-label">成功拉新 (人)</view>
    </view>
    <view class="points-divider"></view>
    <view class="points-col" bindtap="onOpenInvite">
      <view class="points-num">{{pointsData.referralStats.firstOrderCount || 0}}</view>
      <view class="points-label">完成首单 (人)</view>
    </view>
  </view>

  <!-- 核心功能金刚区（4宫格） -->
  <view class="quick-grid">
    <view class="grid-item" bindtap="goOrders">
      <view class="grid-icon">📋</view>
      <text class="grid-label">我的行程</text>
    </view>
    <view class="grid-item" bindtap="goCoupons">
      <view class="grid-icon">🎟️</view>
      <text class="grid-label">优惠券</text>
    </view>
    <view class="grid-item" bindtap="goSafety">
      <view class="grid-icon">🛡️</view>
      <text class="grid-label">安全中心</text>
    </view>
    <view class="grid-item" bindtap="go" data-url="/pages/settings/index?section=invoices">
      <view class="grid-icon">🧾</view>
      <text class="grid-label">{{state.passengerFeatureSwitches.invoice===false ? '历史发票记录' : '发票中心'}}</text>
    </view>
  </view>

  <!-- 常用出行服务列表 -->
  <view class="menu-card">
    <view class="menu-header">出行便民设置</view>
    <view class="menu-row" bindtap="go" data-url="/pages/settings/index?section=riders">
      <view class="menu-left">
        <text class="menu-icon">👥</text>
        <text class="menu-title">乘车人管理</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="go" data-url="/pages/places/index">
      <view class="menu-left">
        <text class="menu-icon">📍</text>
        <text class="menu-title">常用地址（家/公司）</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="onOpenInvite">
      <view class="menu-left">
        <text class="menu-icon">🎁</text>
        <text class="menu-title">邀请功能演示</text>
      </view>
      <view class="menu-right-badge">
        <text class="reward-tag">奖励暂未启用</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
    <view class="menu-row" bindtap="go" data-url="/pages/settings/index?section=blocked">
      <view class="menu-left">
        <text class="menu-icon">🚫</text>
        <text class="menu-title">屏蔽司机名单</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 支持与设置列表 -->
  <view class="menu-card">
    <view class="menu-header">系统与客服</view>
    <view class="menu-row" bindtap="go" data-url="/pages/settings/index?section=profile">
      <view class="menu-left">
        <text class="menu-icon">⚙️</text>
        <text class="menu-title">个人资料与城市作用域</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="go" data-url="/pages/settings/index?section=feedback">
      <view class="menu-left">
        <text class="menu-icon">💬</text>
        <text class="menu-title">意见反馈与平台回复</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="go" data-url="/pages/settings/index?section=support">
      <view class="menu-left">
        <text class="menu-icon">📞</text>
        <text class="menu-title">客服电话与服务能力</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-row" bindtap="go" data-url="/pages/login/index">
      <view class="menu-left">
        <text class="menu-icon">🔌</text>
        <text class="menu-title">体验连接环境配置</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <button wx:if="{{authenticated}}" class="logout-btn" bindtap="logout">退出体验登录</button>
</view>

<!-- 邀请好友与拉新海报弹窗 -->
<view wx:if="{{showInviteModal}}" class="invite-modal-mask">
  <view class="invite-card">
    <view class="invite-banner">
      <view class="invite-title">邀请好友 · 共享好礼</view>
      <view class="invite-sub">邀请功能演示，暂未接入服务端奖励，不发放乘车券或积分</view>
    </view>
    <view class="invite-body">
      <!-- 模拟拉新二维码海报 -->
      <view class="qr-box">
        <view class="qr-mock">
          <text class="qr-icon">📱</text>
          <text class="qr-text">扫码领券出行</text>
        </view>
        <view class="qr-rule-link" bindtap="onOpenRules">查看活动阶梯规则 ›</view>
      </view>

      <view class="code-box">
        <text class="code-label">您的专属邀请码</text>
        <text class="code-value">{{inviteCode}}</text>
      </view>
      <button class="btn-copy" bindtap="onCopyInviteCode">复制专属邀请语与链接</button>
      <button class="btn-close-invite" bindtap="onCloseInvite">关闭</button>
    </view>
  </view>
</view>

<!-- 积分明细弹窗 -->
<view wx:if="{{showPointsModal}}" class="invite-modal-mask">
  <view class="invite-card points-modal-card">
    <view class="invite-banner points-banner">
      <view class="invite-title">我的积分明细</view>
      <view class="invite-sub">可用积分：{{pointsData.availablePoints}} | 累积获得：{{pointsData.totalPoints}}</view>
    </view>
    <scroll-view scroll-y class="points-list-scroll">
      <view wx:for="{{pointsData.history}}" wx:key="id" class="points-item">
        <view class="points-item-left">
          <view class="points-item-title">{{item.typeName}}</view>
          <view class="points-item-desc">{{item.description}}</view>
          <view class="points-item-time">{{item.createdAt}}</view>
        </view>
        <view class="points-item-val {{item.points.indexOf('+') === 0 ? 'pos' : ''}}">{{item.points}}</view>
      </view>
    </scroll-view>
    <button class="btn-close-invite" bindtap="onClosePoints">返回</button>
  </view>
</view>

<!-- 拉新阶梯规则弹窗 -->
<view wx:if="{{showRulesModal}}" class="invite-modal-mask">
  <view class="invite-card">
    <view class="invite-banner">
      <view class="invite-title">拉新奖励活动规则</view>
      <view class="invite-sub">宜捷行营销拉新官方规则说明</view>
    </view>
    <view class="rules-body">
      <view class="rule-tip">活动期间，每邀请一位新用户注册并在平台完成首次行程，邀请人与被邀请人均可享受丰厚奖励：</view>
      <view wx:for="{{pointsData.tierRules}}" wx:key="step" class="rule-tier-row">
        <view class="rule-step-badge">第{{item.step}}阶梯</view>
        <view class="rule-step-info">
          <view class="rule-step-target">{{item.target}}</view>
          <view class="rule-step-reward">奖励：{{item.reward}}</view>
        </view>
      </view>
      <button class="btn-close-invite" bindtap="onCloseRules">我知道了</button>
    </view>
  </view>
</view>