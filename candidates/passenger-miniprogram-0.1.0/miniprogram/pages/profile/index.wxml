<view class="notice">独立体验环境 · 短信、支付与退款均为模拟</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{pending}}" wx:key="requestId" class="notice">{{item.actionText}} · {{item.statusText}}<button size="mini" data-id="{{item.requestId}}" bindtap="retry">原请求重试</button></view><view class="page"><view class="title">我的</view><view class="card"><view class="subtitle">{{state.passenger.name || '宜捷行乘客'}}</view><view class="muted">{{state.passenger.mobile || '登录后管理行程与个人资料'}}</view><button wx:if="{{!authenticated}}" bindtap="login">登录体验</button></view><view class="card menu"><view bindtap="go" data-url="/pages/settings/index?section=profile">个人资料与城市 ›</view><view bindtap="go" data-url="/pages/settings/index?section=riders">乘车人管理 ›</view><view bindtap="go" data-url="/pages/places/index">常用地址 ›</view><view bindtap="go" data-url="/pages/settings/index?section=invoices">发票抬头与模拟回执 ›</view><view bindtap="go" data-url="/pages/settings/index?section=blocked">屏蔽司机 ›</view><view bindtap="go" data-url="/pages/settings/index?section=feedback">意见反馈 ›</view><view bindtap="go" data-url="/pages/settings/index?section=support">公告与客服能力 ›</view><view bindtap="go" data-url="/pages/login/index">体验连接设置 ›</view></view><button wx:if="{{authenticated}}" bindtap="logout">退出登录</button></view>