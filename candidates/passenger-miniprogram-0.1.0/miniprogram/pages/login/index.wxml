<view class="notice">独立体验环境 · 短信、支付与退款均为模拟</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{pending}}" wx:key="requestId" class="notice">{{item.actionText}} · {{item.statusText}}<button size="mini" data-id="{{item.requestId}}" bindtap="retry">原请求重试</button></view><view class="page"><view class="title">欢迎使用宜捷行</view><view class="muted">体验手机号白名单：13800000101、13800000102、13800000103。此处为独立体验账户，不是微信一键登录。</view><view class="card"><view class="subtitle">连接设置</view><input placeholder="HTTPS服务域名" value="{{baseUrl}}" data-field="baseUrl" bindinput="input"/><input password placeholder="单独设置体验访问码" value="{{access}}" data-field="access" bindinput="input"/><button bindtap="saveConfig">保存连接设置</button></view><view class="card"><input type="number" maxlength="11" placeholder="白名单手机号" value="{{mobile}}" data-field="mobile" bindinput="input"/><button bindtap="sendCode" disabled="{{busy}}">获取模拟验证码</button><view class="notice">{{simulation}}</view><input type="number" placeholder="输入模拟验证码" data-field="code" bindinput="input"/><button class="primary" bindtap="submit" disabled="{{busy}}">登录体验</button></view></view>