.order-detail-page {
  min-height: 100vh;
  background-color: #f2f6f7;
  padding: 24rpx;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}

/* 顶部状态横幅 */
.status-banner {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #dce5e8;
}

.stage-badge {
  font-size: 36rpx;
  font-weight: 800;
  color: #00796e;
}

.kind-tag {
  font-size: 22rpx;
  color: #4b5b6b;
  margin-top: 6rpx;
}

.safety-sos-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #fdecea;
  border: 1rpx solid #f3c5c0;
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
}

.sos-icon {
  font-size: 28rpx;
}

.sos-text {
  font-size: 24rpx;
  color: #b42318;
  font-weight: 700;
}

/* 横向流程指示条 */
.stepper-wrap {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #dce5e8;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.step-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #d6e2e0;
}

.step-item.done .step-dot {
  background: #00796e;
  box-shadow: 0 0 10rpx rgba(8, 127, 115, 0.4);
}

.step-label {
  font-size: 20rpx;
  color: #5b6b7a;
}

.step-item.done .step-label {
  color: #00796e;
  font-weight: 600;
}

.step-line {
  flex: 1;
  height: 4rpx;
  background: #eef4f3;
  margin: 0 8rpx -18rpx;
}

.step-line.done {
  background: #00796e;
}

/* 地图 */
.map-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  border: 1rpx solid #dce5e8;
}

.detail-map {
  width: 100%;
  height: 320rpx;
}

.map-hint-text {
  font-size: 20rpx;
  color: #5b6b7a;
  text-align: center;
  padding: 8rpx;
  background: #fbfdfc;
}

/* 司机与车辆卡片 */
.driver-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #dce5e8;
}

.driver-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.driver-avatar {
  font-size: 48rpx;
  background: #e3f4f1;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.driver-info {
  flex: 1;
}

.driver-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.driver-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f1b2a;
}

.rating-star {
  font-size: 22rpx;
  color: #ff9800;
  font-weight: 700;
}

.driver-orders-count {
  font-size: 20rpx;
  color: #4b5b6b;
}

.vehicle-model {
  font-size: 22rpx;
  color: #4b5b6b;
  margin-top: 4rpx;
}

.plate-box {
  background: #00796e;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.driver-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #e6edef;
}

.action-btn {
  flex: 1;
  text-align: center;
  background: #f2f6f7;
  color: #00796e;
  font-size: 24rpx;
  font-weight: 600;
  padding: 14rpx 0;
  border-radius: 12rpx;
}

.driver-loc-time {
  font-size: 20rpx;
  color: #5b6b7a;
  text-align: center;
  margin-top: 12rpx;
}

/* 通用详情卡片 */
.detail-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #dce5e8;
}

.card-header {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f1b2a;
  margin-bottom: 16rpx;
}

.card-header-flex {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.route-point-row {
  display: flex;
  align-items: center;
  padding: 10rpx 0;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 14rpx;
}

.start-dot { background: #00796e; }
.via-dot { background: #0369a1; }
.end-dot { background: #b45309; }

.point-txt {
  font-size: 26rpx;
  color: #0f1b2a;
}

.info-row {
  display: flex;
  font-size: 24rpx;
  padding: 8rpx 0;
}

.info-label {
  color: #4b5b6b;
  width: 150rpx;
}

.info-val {
  color: #0f1b2a;
  flex: 1;
}

/* 费用英雄卡 */
.fee-display-hero {
  text-align: center;
  padding: 16rpx 0 20rpx;
  border-bottom: 1rpx solid #e6edef;
}

.fee-total-big {
  font-size: 60rpx;
  font-weight: 800;
  color: #00796e;
}

.fee-source-desc {
  display: block;
  font-size: 22rpx;
  color: #5b6b7a;
  margin-top: 6rpx;
}

.fee-breakdown {
  padding-top: 16rpx;
}

.breakdown-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  padding: 8rpx 0;
  color: #4b5b6b;
}

.pay-status-pill {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 12rpx;
  background: #e6edef;
  color: #4b5b6b;
}

.pay-status-pill.paid {
  background: #e3f4f1;
  color: #00796e;
  font-weight: 600;
}

/* 竞价卡片 */
.expire-time {
  font-size: 22rpx;
  color: #b42318;
}

.empty-bid-tip {
  text-align: center;
  padding: 36rpx 0;
  color: #4b5b6b;
  font-size: 24rpx;
}

.radar-anim {
  display: block;
  font-size: 44rpx;
  margin-bottom: 12rpx;
}

.bid-driver-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e6edef;
}

.bid-driver-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f1b2a;
}

.bid-plate {
  font-size: 22rpx;
  background: #eef4f3;
  color: #00796e;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}

.bid-driver-car {
  font-size: 22rpx;
  color: #4b5b6b;
  margin-top: 4rpx;
}

.bid-money {
  font-size: 34rpx;
  font-weight: 800;
  color: #00796e;
  text-align: right;
  margin-bottom: 8rpx;
}

.select-driver-btn {
  background: #00796e;
  color: #ffffff;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
}

/* 支付操作栏 */
.pay-action-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(8, 127, 115, 0.15);
  margin-bottom: 20rpx;
  border: 1rpx solid #00796e;
}

.pay-summary {
  font-size: 28rpx;
  color: #0f1b2a;
  text-align: center;
}

.pay-sum-big {
  font-size: 48rpx;
  font-weight: 800;
  color: #00796e;
}

.main-pay-btn {
  background: linear-gradient(135deg, #00796e 0%, #0f9488 100%);
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 40rpx;
  margin-top: 18rpx;
}

.sim-pay-notice {
  font-size: 20rpx;
  color: #5b6b7a;
  text-align: center;
  margin-top: 10rpx;
}

/* 按钮与输入 */
.btn-group-2 {
  display: flex;
  gap: 16rpx;
}

.small-btn {
  flex: 1;
  font-size: 24rpx;
  background: #f2f6f7;
  color: #0f1b2a;
  border-radius: 12rpx;
}

.danger-text {
  color: #b42318;
}

.primary-btn {
  background: #00796e;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

.secondary-btn {
  flex: 1;
  background: #e3f4f1;
  color: #00796e;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.outline-btn {
  background: transparent;
  color: #00796e;
  font-size: 24rpx;
  border: 1rpx solid #00796e;
  border-radius: 12rpx;
  margin-top: 16rpx;
}

.again-btn {
  background: #f2f6f7;
  color: #00796e;
  font-size: 24rpx;
  border-radius: 12rpx;
  margin-top: 20rpx;
}

/* 星级评价 */
.rating-bar {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin: 16rpx 0;
}

.star-item {
  font-size: 54rpx;
  color: #d6e2e0;
}

.star-item.active {
  color: #ff9800;
}

.eval-input, .complaint-input, .dispute-input {
  border: 1rpx solid #dce5e8;
  border-radius: 12rpx;
  padding: 16rpx;
  font-size: 24rpx;
  width: 100%;
  box-sizing: border-box;
  background: #fbfdfc;
  margin-bottom: 16rpx;
}

.remark-input-box {
  border: 1rpx solid #dce5e8;
  border-radius: 10rpx;
  padding: 12rpx 16rpx;
  font-size: 26rpx;
}

/* 投诉回复 */
.complaint-history-item {
  background: #fbfdfc;
  border: 1rpx solid #eef4f3;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 16rpx;
}

.comp-head {
  font-size: 22rpx;
  color: #4b5b6b;
}

.comp-status {
  color: #00796e;
  font-weight: 600;
}

.comp-content {
  font-size: 24rpx;
  color: #0f1b2a;
  margin: 6rpx 0;
}

.admin-reply-box {
  background: #e3f4f1;
  padding: 10rpx 14rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
}

.reply-tag {
  font-size: 20rpx;
  color: #00796e;
  font-weight: 700;
  display: block;
}

.reply-text {
  font-size: 22rpx;
  color: #0f1b2a;
}

/* 时间线 */
.event-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #4b5b6b;
  padding: 6rpx 0;
}

.event-dot {
  color: #00796e;
  margin-right: 12rpx;
  font-size: 16rpx;
}

.event-time {
  margin-right: 16rpx;
  color: #5b6b7a;
}

.order-id-footer {
  font-size: 20rpx;
  color: #9aa8b4;
  margin-top: 16rpx;
  text-align: right;
}

/* 安全弹窗 */
.safety-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.safety-modal-card {
  width: 600rpx;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
}

.safety-modal-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.modal-shield {
  font-size: 40rpx;
}

.modal-header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f1b2a;
}

.safety-feature-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e6edef;
}

.safety-feature-row:last-child {
  border-bottom: none;
}

.feature-icon {
  font-size: 36rpx;
}

.feature-text {
  flex: 1;
}

.feature-text .title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f1b2a;
}

.feature-text .desc {
  display: block;
  font-size: 20rpx;
  color: #4b5b6b;
  margin-top: 2rpx;
}

.mini-red-btn {
  background: #b42318;
  color: #ffffff;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
}

.mini-green-btn {
  background: #00796e;
  color: #ffffff;
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 8rpx;
}

.btn-close-safety {
  margin-top: 24rpx;
  background: #e6edef;
  color: #4b5b6b;
  font-size: 26rpx;
  border-radius: 12rpx;
}

/* 退券提醒 */
.refund-tip-row {
  margin-top: 12rpx;
  padding: 8rpx 14rpx;
  background: #fdf2f2;
  border-radius: 8rpx;
  text-align: left;
}

.refund-tip-text {
  font-size: 22rpx;
  color: #b42318;
}

/* 司机服务卡弹窗 */
.driver-service-card-modal {
  width: 620rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 16rpx 40rpx rgba(0, 0, 0, 0.25);
}

.driver-service-header {
  background: linear-gradient(135deg, #00796e 0%, #0f9488 100%);
  color: #ffffff;
  padding: 28rpx 24rpx;
  text-align: center;
}

.corp-name {
  font-size: 28rpx;
  font-weight: 700;
}

.driver-badge-no {
  font-size: 20rpx;
  opacity: 0.9;
  margin-top: 4rpx;
}

.driver-service-body {
  padding: 28rpx;
}

.service-driver-photo-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 24rpx;
}

.service-photo {
  width: 110rpx;
  height: 110rpx;
  background: #e3f4f1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  border: 4rpx solid #00796e;
}

.service-driver-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f1b2a;
  margin-top: 10rpx;
}

.service-driver-score {
  font-size: 22rpx;
  color: #4b5b6b;
  margin-top: 4rpx;
}

.score-val {
  color: #00796e;
  font-weight: 700;
}

.service-info-grid {
  background: #f7faf9;
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.service-info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 22rpx;
}

.service-info-item .label {
  color: #4b5b6b;
}

.service-info-item .val {
  color: #0f1b2a;
  font-weight: 600;
}

.service-promise-tip {
  margin-top: 20rpx;
  font-size: 20rpx;
  color: #00796e;
  line-height: 1.4;
  text-align: center;
}

.btn-close-service-card {
  margin: 0 28rpx 28rpx;
  background: #00796e;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
}
