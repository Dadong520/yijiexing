.coupons-page {
  min-height: 100vh;
  background-color: #f5f9f8;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 兑换码区域 */
.claim-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(8, 127, 115, 0.05);
  border: 1rpx solid #e2ebe9;
}

.claim-input {
  flex: 1;
  font-size: 26rpx;
  color: #1a2d2a;
}

.claim-btn {
  background: #087f73;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 12rpx;
  padding: 10rpx 24rpx;
  margin: 0;
}

.tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(8, 127, 115, 0.05);
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #647774;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.tab.active {
  background-color: #087f73;
  color: #ffffff;
  font-weight: 600;
}

.coupon-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.coupon-card {
  display: flex;
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
  border: 1rpx solid #e2ebe9;
}

.coupon-card.disabled {
  opacity: 0.65;
  filter: grayscale(70%);
}

.coupon-left {
  width: 200rpx;
  background: linear-gradient(135deg, #087f73 0%, #0ca798 100%);
  color: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 12rpx;
}

.amount-wrap {
  display: flex;
  align-items: baseline;
}

.symbol {
  font-size: 28rpx;
  font-weight: 500;
}

.amount {
  font-size: 48rpx;
  font-weight: 700;
  margin-left: 4rpx;
}

.condition {
  font-size: 20rpx;
  opacity: 0.9;
  margin-top: 8rpx;
  text-align: center;
}

.coupon-divider {
  width: 0;
  border-right: 2rpx dashed #d6e2e0;
}

.coupon-right {
  flex: 1;
  padding: 20rpx 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.coupon-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2d2a;
}

.coupon-desc {
  font-size: 22rpx;
  color: #647774;
  margin-top: 6rpx;
}

.coupon-tags-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.rule-chip {
  font-size: 18rpx;
  color: #087f73;
  background: #e6f5f3;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
}

.rule-chip-tip {
  color: #647774;
  background: #f2f6f5;
}

.coupon-bottom-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}

.coupon-expire {
  font-size: 20rpx;
  color: #92a4a1;
}

.use-btn {
  background-color: #087f73;
  color: #ffffff;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.used-tag {
  font-size: 20rpx;
  color: #92a4a1;
  padding: 4rpx 12rpx;
  background: #f0f4f3;
  border-radius: 6rpx;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #92a4a1;
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.empty-icon {
  font-size: 64rpx;
}
