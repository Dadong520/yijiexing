<view class="notice">独立体验环境 · 短信、支付与退款均为模拟</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{pending}}" wx:key="requestId" class="notice">{{item.actionText}} · {{item.statusText}}<button size="mini" data-id="{{item.requestId}}" bindtap="retry">原请求重试</button></view><view class="page"><view class="title">{{purpose?'选择地点':'常用地址'}}</view><view class="card"><view class="subtitle">常用地址</view><view class="empty" wx:if="{{!state.favorites.length}}">暂无常用地址</view><view wx:for="{{state.favorites}}" wx:key="id" class="row"><view data-source="favorites" data-index="{{index}}" bindtap="select">{{item.label}} · {{item.address}}</view><button wx:if="{{!purpose}}" size="mini" data-id="{{item.id}}" bindtap="remove">删除</button></view></view><view class="card"><view class="subtitle">历史地点</view><view class="menu"><view wx:for="{{state.historicalLocations}}" wx:key="index" data-source="history" data-index="{{index}}" bindtap="select">{{item.address}} ›</view></view></view><view class="card"><view class="subtitle">体验地点</view><view class="muted">以下为固定体验坐标，不是您的真实位置。</view><view class="menu"><view wx:for="{{experiences}}" wx:key="index" data-source="experiences" data-index="{{index}}" bindtap="select">{{item.address}} ›</view></view></view><view class="card"><view class="subtitle">{{purpose?'手填已知地点':'添加常用地址'}}</view><button bindtap="choose">地图选点</button><input wx:if="{{!purpose}}" placeholder="标签，如家 / 公司" data-field="label" value="{{label}}" bindinput="input"/><input placeholder="地址名称" data-field="address" value="{{address}}" bindinput="input"/><input type="digit" placeholder="已知 WGS84 纬度" data-field="latitude" value="{{latitude}}" bindinput="input"/><input type="digit" placeholder="已知 WGS84 经度" data-field="longitude" value="{{longitude}}" bindinput="input"/><view class="muted">手填仅适用于您已知准确坐标的地点；不自动推断定位。</view><button class="primary" bindtap="save" disabled="{{busy}}">{{purpose?'使用此地点':'保存地址'}}</button></view></view>