<view class="safety-page">
  <view class="hero-shield-card">
    <view class="shield-icon">🛡️</view>
    <view class="shield-info">
      <view class="shield-title">宜捷行安全护航中</view>
      <view class="shield-sub">全程轨迹记录 · 录音保护 · 24小时守护</view>
    </view>
  </view>

  <!-- 安全设置卡片 -->
  <view class="section-card">
    <view class="card-title">安全守护设置</view>
    <view class="setting-item">
      <view class="setting-text">
        <text class="name">夜间自动守护 (22:00-06:00)</text>
        <text class="desc">夜间行程自动开启高频轨迹记录与预警提示</text>
      </view>
      <switch checked="{{config.autoShareNight}}" bindchange="onToggleNight" color="#087f73" />
    </view>
    <view class="setting-item">
      <view class="setting-text">
        <text class="name">行程录音保护</text>
        <text class="desc">行程中加密记录音频，仅用于投诉争议核实</text>
      </view>
      <switch checked="{{config.audioRecordProtection}}" bindchange="onToggleAudio" color="#087f73" />
    </view>
  </view>

  <!-- 紧急联系人卡片 -->
  <view class="section-card">
    <view class="card-header-flex">
      <view class="card-title">紧急联系人</view>
      <view class="add-btn" bindtap="openAddModal">+ 添加联系人</view>
    </view>
    <view class="contact-list">
      <block wx:for="{{contacts}}" wx:key="id">
        <view class="contact-item">
          <view class="contact-info">
            <view class="name-rel">
              <text class="name">{{item.name}}</text>
              <text class="rel-tag">{{item.relation}}</text>
            </view>
            <view class="phone">{{item.phone}}</view>
          </view>
          <view class="del-btn" bindtap="onRemoveContact" data-id="{{item.id}}">删除</view>
        </view>
      </block>
      <view wx:if="{{contacts.length === 0}}" class="empty-tip">未添加紧急联系人，建议至少添加1位</view>
    </view>
  </view>

  <!-- 紧急求助入口 -->
  <view class="section-card emergency-box">
    <view class="card-title" style="color: #d93025;">紧急求助通道</view>
    <view class="emergency-desc">遇到危险情况时，请立即拨打报警电话或触发一键求助：</view>
    <view class="emergency-actions">
      <button class="btn-police" bindtap="onCallPolice">🚨 一键拨打 110</button>
      <button class="btn-sos" bindtap="onSendSos">📲 模拟向联系人求助</button>
    </view>
  </view>

  <!-- 添加联系人弹窗 -->
  <view wx:if="{{showModal}}" class="modal-mask">
    <view class="modal-box">
      <view class="modal-title">添加紧急联系人</view>
      <view class="input-group">
        <text class="label">姓名</text>
        <input class="input" placeholder="请输入联系人姓名" value="{{inputName}}" bindinput="onInputName" />
      </view>
      <view class="input-group">
        <text class="label">手机号码</text>
        <input class="input" type="number" placeholder="请输入11位手机号" value="{{inputPhone}}" bindinput="onInputPhone" />
      </view>
      <view class="input-group">
        <text class="label">关系</text>
        <input class="input" placeholder="例如：家人 / 朋友 / 同事" value="{{inputRelation}}" bindinput="onInputRelation" />
      </view>
      <view class="modal-actions">
        <button class="btn-cancel" bindtap="closeAddModal">取消</button>
        <button class="btn-confirm" bindtap="confirmAddContact">保存</button>
      </view>
    </view>
  </view>
</view>
