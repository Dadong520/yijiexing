.safety-page {
  min-height: 100vh;
  background-color: #f5f9f8;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero-shield-card {
  background: linear-gradient(135deg, #087f73 0%, #0ca798 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(8, 127, 115, 0.25);
  margin-bottom: 24rpx;
}

.shield-icon {
  font-size: 64rpx;
}

.shield-title {
  font-size: 34rpx;
  font-weight: 700;
}

.shield-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

.section-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #e2ebe9;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2d2a;
}

.card-header-flex {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.add-btn {
  font-size: 26rpx;
  color: #087f73;
  font-weight: 600;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f4f3;
}

.setting-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.setting-text {
  flex: 1;
  padding-right: 20rpx;
}

.setting-text .name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #1a2d2a;
}

.setting-text .desc {
  display: block;
  font-size: 22rpx;
  color: #647774;
  margin-top: 6rpx;
}

.contact-list {
  display: flex;
  flex-direction: column;
}

.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f4f3;
}

.contact-item:last-child {
  border-bottom: none;
}

.name-rel {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.contact-item .name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2d2a;
}

.rel-tag {
  font-size: 20rpx;
  background: #e6f5f3;
  color: #087f73;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.contact-item .phone {
  font-size: 24rpx;
  color: #647774;
  margin-top: 4rpx;
}

.del-btn {
  font-size: 24rpx;
  color: #d93025;
  padding: 8rpx 16rpx;
}

.emergency-box {
  border-left: 8rpx solid #d93025;
}

.emergency-desc {
  font-size: 24rpx;
  color: #647774;
  margin: 12rpx 0 20rpx;
}

.emergency-actions {
  display: flex;
  gap: 16rpx;
}

.btn-police {
  flex: 1;
  background: #d93025;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.btn-sos {
  flex: 1;
  background: #fce8e6;
  color: #d93025;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: 1rpx solid #fad2cf;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-box {
  width: 600rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a2d2a;
  margin-bottom: 24rpx;
  text-align: center;
}

.input-group {
  margin-bottom: 20rpx;
}

.input-group .label {
  display: block;
  font-size: 24rpx;
  color: #647774;
  margin-bottom: 8rpx;
}

.input-group .input {
  border: 1rpx solid #d6e2e0;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  font-size: 28rpx;
  background: #fbfdfc;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.btn-cancel {
  flex: 1;
  background: #f0f4f3;
  color: #647774;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.btn-confirm {
  flex: 1;
  background: #087f73;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.empty-tip {
  text-align: center;
  padding: 32rpx 0;
  color: #92a4a1;
  font-size: 24rpx;
}
