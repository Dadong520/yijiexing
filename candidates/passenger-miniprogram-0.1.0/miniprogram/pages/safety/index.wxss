.safety-page {
  min-height: 100vh;
  background-color: #f2f6f7;
  padding: 24rpx;
  box-sizing: border-box;
}

.hero-shield-card {
  background: linear-gradient(135deg, #00796e 0%, #0f9488 100%);
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  color: #ffffff;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(8, 127, 115, 0.25);
  margin-bottom: 24rpx;
}

.shield-icon {
  font-size: 64rpx;
}

.shield-title {
  font-size: 34rpx;
  font-weight: 700;
}

.shield-sub {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

.section-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #dce5e8;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f1b2a;
}

.card-header-flex {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.add-btn {
  font-size: 26rpx;
  color: #00796e;
  font-weight: 600;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e6edef;
}

.setting-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.setting-text {
  flex: 1;
  padding-right: 20rpx;
}

.setting-text .name {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  color: #0f1b2a;
}

.setting-text .desc {
  display: block;
  font-size: 22rpx;
  color: #4b5b6b;
  margin-top: 6rpx;
}

.contact-list {
  display: flex;
  flex-direction: column;
}

.contact-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #e6edef;
}

.contact-item:last-child {
  border-bottom: none;
}

.name-rel {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.contact-item .name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f1b2a;
}

.rel-tag {
  font-size: 20rpx;
  background: #e3f4f1;
  color: #00796e;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}

.contact-item .phone {
  font-size: 24rpx;
  color: #4b5b6b;
  margin-top: 4rpx;
}

.del-btn {
  font-size: 24rpx;
  color: #b42318;
  padding: 8rpx 16rpx;
}

.emergency-box {
  border-left: 8rpx solid #b42318;
}

.emergency-desc {
  font-size: 24rpx;
  color: #4b5b6b;
  margin: 12rpx 0 20rpx;
}

.emergency-actions {
  display: flex;
  gap: 16rpx;
}

.btn-police {
  flex: 1;
  background: #b42318;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.btn-sos {
  flex: 1;
  background: #fdecea;
  color: #b42318;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: 1rpx solid #f3c5c0;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-box {
  width: 600rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f1b2a;
  margin-bottom: 24rpx;
  text-align: center;
}

.input-group {
  margin-bottom: 20rpx;
}

.input-group .label {
  display: block;
  font-size: 24rpx;
  color: #4b5b6b;
  margin-bottom: 8rpx;
}

.input-group .input {
  border: 1rpx solid #d6e2e0;
  border-radius: 10rpx;
  padding: 14rpx 18rpx;
  font-size: 28rpx;
  background: #fbfdfc;
}

.modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.btn-cancel {
  flex: 1;
  background: #e6edef;
  color: #4b5b6b;
  font-size: 28rpx;
  border-radius: 12rpx;
}

.btn-confirm {
  flex: 1;
  background: #00796e;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
}

.empty-tip {
  text-align: center;
  padding: 32rpx 0;
  color: #5b6b7a;
  font-size: 24rpx;
}
