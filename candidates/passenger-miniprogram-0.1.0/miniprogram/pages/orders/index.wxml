<view class="notice">独立体验环境 · 短信、支付与退款均为模拟</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:for="{{pending}}" wx:key="requestId" class="notice">{{item.actionText}} · {{item.statusText}}<button size="mini" data-id="{{item.requestId}}" bindtap="retry">原请求重试</button></view><view class="page"><view class="title">我的行程</view><button wx:if="{{!authenticated}}" bindtap="login">登录查看行程</button><view wx:if="{{authenticated && !orders.length}}" class="empty">还没有行程，去打车页开始一次体验。</view><view class="card" wx:for="{{orders}}" wx:key="id" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="subtitle">{{item.kindText}}</text><text class="badge">{{item.stageText}}</text></view><view class="route">● {{item.origin}}</view><view class="route">● {{item.destinationPending?'目的地待补充':item.destination}}</view><view class="row muted"><text>{{item.createdAtText}}</text><text>{{item.fareText}}</text></view></view></view>